{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "build/**"
      ]
    },
    "lint": {},
    "lint:fix": {},
    "packages-update": {},
    "start": {
      "cache": false,
      "persistent": true
    },
    "start:hot": {
      "cache": false,
      "persistent": true
    },
    "stylelint": {},
    "stylelint:fix": {},
    "test": {},
    "test:watch": {}
  }
}
