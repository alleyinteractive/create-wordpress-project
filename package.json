{
  "workspaces": [
    "packages/*",
    "plugins/create-wordpress-plugin",
    "themes/create-wordpress-theme"
  ],
  "dependencies": {
    "@alleyinteractive/block-editor-tools": "^0.14.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "@wordpress/block-editor": "^14.14.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@alleyinteractive/build-tool": "^0.2.2",
    "@alleyinteractive/create-entry": "^0.1.0",
    "@alleyinteractive/eslint-config": "^0.2.0",
    "@alleyinteractive/stylelint-config": "^0.1.0",
    "@alleyinteractive/tsconfig": "^0.3.0",
    "@babel/preset-env": "^7.28.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/wordpress__block-editor": "^11.5.17",
    "@types/wordpress__blocks": "^12.5.18",
    "@types/wordpress__edit-post": "^8.4.2",
    "@wordpress/babel-preset-default": "^8.32.0",
    "@wordpress/scripts": "^30.25.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "stylelint-config-sass-guidelines": "^9.0.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "webpack-cli": "^5.1.4",
    "wp-types": "^4.68.1"
  },
  "engines": {
    "node": "22",
    "npm": "10"
  },
  "license": "GPL-2.0-or-later",
  "name": "create-wordpress-project",
  "scripts": {
    "build": "turbo run build",
    "check-types": "tsc --noEmit",
    "create-package": "turbo gen workspace --destination packages --type package",
    "eslint": "turbo run eslint",
    "eslint:fix": "turbo run eslint:fix",
    "jest": "turbo run jest",
    "jest:watch": "turbo run jest:watch",
    "packages-update": "alley-build packages-update --dist-tag=wp-6.8",
    "start": "turbo run start",
    "start:hot": "turbo run start:hot",
    "stylelint": "turbo run stylelint",
    "stylelint:fix": "turbo run stylelint:fix",
    "test": "npm run check-types && turbo run eslint stylelint jest"
  },
  "version": "1.0.0",
  "packageManager": "npm@10.9.2"
}
