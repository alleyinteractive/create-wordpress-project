{
  "workspaces": [
    "packages/*",
    "plugins/create-wordpress-plugin",
    "themes/create-wordpress-theme"
  ],
  "dependencies": {
    "@alleyinteractive/block-editor-tools": "^0.17.0"
  },
  "devDependencies": {
    "@alleyinteractive/build-tool": "^0.3.0",
    "@alleyinteractive/create-entry": "^0.2.0",
    "@alleyinteractive/eslint-config": "^0.2.0",
    "@alleyinteractive/stylelint-config": "^0.2.0",
    "@alleyinteractive/tsconfig": "^0.3.0",
    "@babel/preset-env": "^7.29.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/wordpress__block-editor": "^15.0.6",
    "@types/wordpress__blocks": "^15.10.2",
    "@wordpress/babel-preset-default": "8.40.1",
    "@wordpress/block-editor": "15.13.2",
    "@wordpress/blocks": "15.13.1",
    "@wordpress/components": "32.2.1",
    "@wordpress/data": "10.40.1",
    "@wordpress/i18n": "6.13.1",
    "@wordpress/plugins": "7.40.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "ts-jest": "^29.4.14",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "webpack-cli": "^7.2.3",
    "wp-types": "^4.71.0"
  },
  "engines": {
    "node": "24",
    "npm": "11"
  },
  "license": "GPL-2.0-or-later",
  "name": "create-wordpress-project",
  "scripts": {
    "build": "turbo run build",
    "check-types": "tsc --noEmit",
    "create-package": "turbo gen workspace --destination packages --type package",
    "eslint": "turbo run eslint",
    "eslint:fix": "turbo run eslint:fix",
    "jest": "turbo run jest",
    "jest:watch": "turbo run jest:watch",
    "packages-update": "alley-build packages-update --dist-tag=wp-7.0",
    "start": "turbo run start",
    "start:hot": "turbo run start:hot",
    "stylelint": "turbo run stylelint",
    "stylelint:fix": "turbo run stylelint:fix",
    "test": "npm run check-types && turbo run eslint stylelint jest"
  },
  "version": "1.0.0",
  "packageManager": "npm@11.13.0"
}
